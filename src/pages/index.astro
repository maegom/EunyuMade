---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import type { TileItem } from '../components/Tile.astro';
import { getCollection } from 'astro:content';
import { site, soloLabel, projectHref, getPlays } from '../data/site';

const seriesAll = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const seriesOf = (id?: string) => (id ? seriesAll.find((s) => s.id === id) : undefined);

// 아이디어 단계는 선반에 올리지 않습니다.
// 순서: featured가 맨 앞 → 시리즈 순서(series 파일의 order, 독립 프로젝트는 맨 뒤) → 프로젝트 order.
const seriesOrder = (id?: string) => (id ? (seriesOf(id)?.data.order ?? 99) : 100);
const projects = (await getCollection('projects'))
  .filter((p) => p.data.status !== 'idea')
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      seriesOrder(a.data.series) - seriesOrder(b.data.series) ||
      a.data.order - b.data.order
  );

const items: TileItem[] = projects.map((p) => ({
  title: p.data.title,
  href: projectHref(p.data.series, p.id),
  kind: p.data.kind,
  status: p.data.status,
  series: seriesOf(p.data.series)?.data.title ?? soloLabel,
  cat: p.data.series ?? 'solo',
  cover: p.data.cover, // 사진이 없으면 이름이 들어간 타일로 표시됩니다.
  loop: p.data.loop,
  one_line: p.data.one_line,
  plays: getPlays(p.data),
  featured: p.data.featured,
}));

// 은유제작소 자체(정체성 프로젝트)도 독립 프로젝트 하나로 올립니다.
items.push({
  title: '은유제작소',
  href: '/about',
  kind: 'web',
  status: 'making',
  series: soloLabel,
  cat: 'solo',
  cover: site.mark,
  contain: true,
  one_line: '설명하는 대신 체험하게 하는 페이지',
});

const cats = [
  ...seriesAll
    .filter((s) => items.some((i) => i.cat === s.id))
    .map((s) => ({ id: s.id, label: `${s.data.title} 시리즈`, tagline: s.data.tagline, href: `/${s.id}` })),
  ...(items.some((i) => i.cat === 'solo') ? [{ id: 'solo', label: soloLabel, tagline: '시리즈에 묶이지 않는 하나짜리 작업', href: '' }] : []),
];
const count = (id: string) => items.filter((i) => i.cat === id).length;
const nowList = projects.filter((p) => ['prototype', 'making'].includes(p.data.status)).map((p) => p.data.title);
---
<Base>
  <main class="container">
    <section class="intro">
      <h1>은유제작소가 만든 것들.</h1>
      <p class="intro-sub">{site.tagline}</p>
      {nowList.length > 0 && (
        <p class="now"><span class="now-dot" aria-hidden="true"></span>지금 만드는 중: {nowList.join(', ')}</p>
      )}
    </section>

    {cats.length > 1 && (
      <div class="tabs" role="tablist" aria-label="분류">
        <button class="tab" role="tab" type="button" aria-selected="true" data-cat="all">전체 <span class="cnt">{items.length}</span></button>
        {cats.map((c) => (
          <button class="tab" role="tab" type="button" aria-selected="false" data-cat={c.id}>{c.label} <span class="cnt">{count(c.id)}</span></button>
        ))}
      </div>
    )}

    {cats.map((c) => (
      <div class="strip" data-strip={c.id} hidden>
        <div><b>{c.label}</b><span>{c.tagline}</span></div>
        {c.href && <a class="btn small" href={c.href}>시리즈 페이지 →</a>}
      </div>
    ))}

    <div class="shelf-grid" id="grid">
      {items.map((item) => <Tile {...item} />)}
    </div>
  </main>
</Base>

<script>
  // 분류 탭: 정적 페이지 위의 작은 필터. 기본은 전체.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('#grid [data-cat]'));
  const strips = Array.from(document.querySelectorAll<HTMLElement>('[data-strip]'));
  function pick(cat: string) {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.cat === cat)));
    tiles.forEach((el) => { el.hidden = cat !== 'all' && el.dataset.cat !== cat; });
    strips.forEach((s) => { s.hidden = s.dataset.strip !== cat; });
    try { history.replaceState(null, '', cat === 'all' ? location.pathname : `#${cat}`); } catch {}
  }
  tabs.forEach((t) => t.addEventListener('click', () => pick(t.dataset.cat || 'all')));
  const initial = location.hash.slice(1);
  if (initial && tabs.some((t) => t.dataset.cat === initial)) pick(initial);
</script>

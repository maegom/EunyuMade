---
import Base from '../layouts/Base.astro';
import { site, withSource } from '../data/site';
const links = site.links as Record<string, string>;
const ext = (key: string) => (links[key] ? withSource(links[key], 'card') : '');
const instagram = ext('instagram');
const youtube = ext('youtube');
const store = ext('store');
const support = ext('support');
const mailHref = `mailto:${site.email}?subject=${encodeURIComponent('[은유제작소] 명함을 보고 연락드립니다')}`;
---
<Base title="명함" bare noindex description="은유제작소 명함 페이지">
  <Fragment slot="head">
    <style>
      body{background:linear-gradient(180deg,#F5FAFE 0%,#EAF5FD 100%);min-height:100vh}
      .cwrap{max-width:420px;margin:0 auto;padding:max(28px,env(safe-area-inset-top)) 18px max(32px,env(safe-area-inset-bottom))}
      .ccard{background:#fff;border:1px solid var(--line);border-radius:24px;padding:30px 26px 26px;box-shadow:0 16px 48px rgba(63,169,245,.16);text-align:center}
      .ccard img{width:210px;height:auto;margin:0 auto}
      .ccard .en{margin-top:10px;font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:var(--blue)}
      .ccard .en::before{content:"";display:inline-block;width:6px;height:6px;background:var(--blue);transform:rotate(45deg);margin:0 8px 1px 0;vertical-align:middle}
      .ccard p{margin:12px 0 0;color:var(--ink2);font-size:15px}
      .clinks{display:grid;gap:10px;margin-top:16px}
      .cbtn{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:0 20px;border-radius:999px;background:#fff;border:1px solid var(--line);font-weight:700;font-size:16px;cursor:pointer;text-align:left;width:100%;transition:transform .15s,border-color .15s,background .15s}
      .cbtn:hover{transform:translateY(-1px);border-color:var(--blue)}
      .cbtn.primary{background:var(--blue);color:#fff;border-color:var(--blue)}
      .cbtn.primary:hover{background:var(--blue-deep);border-color:var(--blue-deep)}
      .cbtn .l{display:flex;align-items:center;gap:10px}
      .cbtn svg{width:20px;height:20px;flex:none}
      .cbtn .sub{font-weight:500;font-size:13px;color:var(--ink3);white-space:nowrap}
      .cbtn.primary .sub{color:rgba(255,255,255,.85)}
      .crow{display:grid;grid-template-columns:1fr 1fr;gap:10px}
      .crow .cbtn{justify-content:center}
      .cfoot{margin-top:20px;text-align:center;font-family:var(--mono);font-size:12px;color:var(--ink3)}
      @media (prefers-reduced-motion:reduce){.cbtn{transition:none}.cbtn:hover{transform:none}}
    </style>
  </Fragment>
  <main class="cwrap">
    <section class="ccard">
      <img src={site.logo} alt="은유제작소" width="210" height="210" />
      <div class="en">Eunyu Made</div>
      <p>{site.tagline}</p>
    </section>
    <nav class="clinks" aria-label="바로가기">
      {instagram && (
        <a class="cbtn primary" href={instagram} target="_blank" rel="noopener">
          <span class="l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>Instagram</span><span class="sub">↗</span>
        </a>
      )}
      <a class="cbtn" href="/?from=card">홈페이지 <span class="sub">eunyumade.com</span></a>
      <a class="cbtn" href="/happy?from=card">HAPPY 시리즈 <span class="sub">만나보기</span></a>
      {youtube && <a class="cbtn" href={youtube} target="_blank" rel="noopener">YouTube <span class="sub">↗</span></a>}
      {store && <a class="cbtn" href={store} target="_blank" rel="noopener">스토어 <span class="sub">↗</span></a>}
      {support && <a class="cbtn" href={support} target="_blank" rel="noopener">후원 <span class="sub">↗</span></a>}
      <a class="cbtn" href={mailHref}>메일 보내기 <span class="sub">{site.email}</span></a>
      <div class="crow">
        <button class="cbtn" type="button" id="copyBtn" data-email={site.email}>주소 복사</button>
        <a class="cbtn" href="/eunyumade.vcf" download="eunyumade.vcf">연락처 저장</a>
      </div>
    </nav>
    <p class="cfoot">© {new Date().getFullYear()} EUNYU MADE</p>
  </main>
  <script>
    const btn = document.getElementById('copyBtn') as HTMLButtonElement | null;
    if (btn) {
      const email = btn.dataset.email || '';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
          btn.textContent = '복사됨 ✓';
          setTimeout(() => (btn.textContent = '주소 복사'), 1600);
        } catch {
          window.prompt('이메일 주소를 복사하세요.', email);
        }
      });
    }
  </script>
</Base>

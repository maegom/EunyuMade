---
// 시리즈 전용 페이지는 두지 않습니다. 예전 주소(/happy 등)로 들어오면 홈의 해당 분류로 보냅니다.
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('series');
  return all.map((entry) => ({ params: { series: entry.id } }));
}
const { series } = Astro.params;
const to = `/#${series}`;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>은유제작소 | EUNYU MADE</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href="https://www.eunyumade.com/" />
  </head>
  <body>
    <p><a href={to}>은유제작소가 만든 것들로 이동</a></p>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </body>
</html>

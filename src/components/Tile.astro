---
import StatusChip from './StatusChip.astro';
import { kindLabel, isExternal, type Kind, type Status, type Play } from '../data/site';

export interface TileItem {
  title: string;
  href: string;
  kind: Kind;
  status: Status;
  series?: string; // 표시용 분류 이름 (예: HAPPY, 독립 프로젝트)
  cat?: string; // 필터용 분류 키 (예: happy, solo)
  cover?: string;
  contain?: boolean; // 커버를 잘라내지 않고 여백을 두고 넣기 (픽토그램 등)
  loop?: string;
  one_line?: string;
  plays?: Play[]; // 첫 항목이 타일의 "실행하기" 버튼
  featured?: boolean;
}
interface Props extends TileItem {}
const { title, href, kind, status, series, cat, cover, contain = false, loop, one_line, plays = [], featured = false } = Astro.props;
const dim = status === 'idea';
// 체험이 1개면 "실행하기", 2~3개면 이름별 버튼, 그보다 많으면 상세 페이지로.
const many = plays.length > 3;
---
<article class:list={['tile', { feat: featured, dim, contain }]} data-cat={cat}>
  <div class="tile-media">
    {cover
      ? <img src={cover} alt="" loading="lazy" />
      : <div class="tile-type" aria-hidden="true"><span>{title}</span></div>}
    {loop && <video src={loop} muted loop playsinline preload="none" aria-hidden="true"></video>}
  </div>
  <div class="tile-meta">
    <div class="tile-top">
      <span class="tile-labels">
        {series && <span>{series}</span>}
        <span>{kindLabel[kind]}</span>
      </span>
      <StatusChip status={status} />
    </div>
    <div class="tile-title">{dim ? title : <a class="tile-link" href={href}>{title}</a>}</div>
    {one_line && <div class="tile-line">{one_line}</div>}
    {plays.length > 0 && !dim && (
      <div class="play-row">
        {many
          ? <a class="play-pill" href={`${href}#play`}>실행하기 · {plays.length}개 →</a>
          : plays.map((p) => {
              const ext = isExternal(p.url);
              return <a class="play-pill" href={p.url} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{plays.length === 1 ? '실행하기' : p.label}{ext ? ' ↗' : ''}</a>;
            })}
      </div>
    )}
  </div>
</article>
